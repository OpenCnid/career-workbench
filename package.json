{
  "name": "career-workbench",
  "version": "0.1.0-preview.0",
  "private": true,
  "description": "Local-first, evidence-based career intelligence and application operations.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.24.0"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @career-workbench/web build",
    "clean": "pnpm -r exec tsc -b --clean",
    "dev": "concurrently -k -n server,web \"pnpm --filter @career-workbench/server dev\" \"pnpm --filter @career-workbench/web dev\"",
    "dsh:authorize": "tsx scripts/authorize-openai-codex.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "tsc -b --pretty false && eslint .",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.tools.json --pretty false",
    "test": "vitest run --project unit --project contract",
    "test:unit": "vitest run --project unit",
    "test:property": "vitest run --project property",
    "test:contract": "vitest run --project contract",
    "test:integration": "vitest run --project integration",
    "test:live": "pnpm build && tsx scripts/live-acceptance.ts",
    "test:security": "vitest run --project security",
    "test:e2e": "pnpm build && playwright test",
    "test:a11y": "pnpm build && playwright test --grep @a11y",
    "test:all": "vitest run",
    "check:contracts": "tsx scripts/check-contract-examples.ts",
    "check:provenance": "tsx scripts/check-provenance.ts",
    "check:patches": "tsx scripts/check-dsh-patches.ts",
    "check:hygiene": "tsx scripts/check-hygiene.ts",
    "check:docs": "tsx scripts/check-docs.ts",
    "check:packages": "tsx scripts/check-packages.ts",
    "check:clean-install": "tsx scripts/check-clean-install.ts",
    "check:clean-lockfile": "tsx scripts/check-clean-install.ts --lockfile-only",
    "release:prepare": "pnpm build && tsx scripts/create-release-bundles.ts && pnpm run sbom && prettier --write sbom.cdx.json && pnpm run checksums",
    "check:release": "tsx scripts/check-release.ts",
    "check:isolated": "tsx scripts/check-isolated-install.ts",
    "workspace:admin": "tsx scripts/workspace-admin.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:all && pnpm check:contracts && pnpm check:provenance && pnpm check:patches && pnpm check:hygiene && pnpm check:docs && pnpm build && pnpm check:packages",
    "sbom": "pnpm sbom --sbom-format cyclonedx --sbom-spec-version 1.6 --lockfile-only --out sbom.cdx.json",
    "checksums": "tsx scripts/create-checksums.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-agent-loop": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-atomic-write": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-attachment": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-authorization": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-credentials": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-credentials-local": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-fs": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-home-paths": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-invariants": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-jobs": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-launch-environment": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-llm-pi-ai": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-sandbox": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-session-projection": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-session-query": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-session-title": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-settings": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-subagent": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-subagent-spawn-in-process": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-tool-todo": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-timeout": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.3",
    "@deepseek-rlm/dsh-rlm-jupyter": "workspace:*",
    "@deepseek-rlm/dsh-tool-ipython": "workspace:*",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.10.0",
    "@types/better-sqlite3": "7.6.13",
    "@vitest/coverage-v8": "4.1.11",
    "concurrently": "10.0.5",
    "better-sqlite3": "13.0.3",
    "eslint": "10.9.1",
    "fast-check": "4.9.0",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  }
}
