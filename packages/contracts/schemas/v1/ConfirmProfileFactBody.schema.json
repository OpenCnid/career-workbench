{
  "$id": "ConfirmProfileFactBody",
  "additionalProperties": false,
  "type": "object",
  "required": ["expectedRevision", "outcome"],
  "properties": {
    "expectedRevision": { "minimum": 1, "type": "integer" },
    "outcome": {
      "anyOf": [
        {
          "additionalProperties": false,
          "type": "object",
          "required": ["kind"],
          "properties": { "kind": { "const": "confirm", "type": "string" } }
        },
        {
          "additionalProperties": false,
          "type": "object",
          "required": ["kind", "value", "locator"],
          "properties": {
            "kind": { "const": "correct", "type": "string" },
            "value": {
              "anyOf": [
                { "maxLength": 2000, "type": "string" },
                { "type": "number" },
                { "type": "boolean" },
                { "type": "null" }
              ]
            },
            "locator": {
              "additionalProperties": false,
              "type": "object",
              "required": ["sourceId", "start", "end", "quote"],
              "properties": {
                "sourceId": {
                  "minLength": 10,
                  "maxLength": 80,
                  "pattern": "^[a-z][a-z0-9_]*_[0-9A-HJKMNP-TV-Z]{10,64}$",
                  "type": "string"
                },
                "start": {
                  "minimum": 0,
                  "maximum": 1048576,
                  "type": "integer"
                },
                "end": { "minimum": 1, "maximum": 1048576, "type": "integer" },
                "quote": {
                  "minLength": 1,
                  "maxLength": 10000,
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "additionalProperties": false,
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "const": "narrative_only", "type": "string" }
          }
        },
        {
          "additionalProperties": false,
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "const": "cannot_confirm", "type": "string" }
          }
        }
      ]
    }
  }
}
