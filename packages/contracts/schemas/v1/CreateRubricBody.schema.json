{
  "$id": "CreateRubricBody",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "semanticVersion",
    "name",
    "dimensions",
    "thresholds",
    "displayScale"
  ],
  "properties": {
    "semanticVersion": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "maxLength": 30,
      "type": "string"
    },
    "name": { "minLength": 1, "maxLength": 200, "type": "string" },
    "dimensions": {
      "minItems": 1,
      "maxItems": 32,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "key",
          "label",
          "weightBasisPoints",
          "missingInput",
          "criticalMinimumBasisPoints"
        ],
        "properties": {
          "key": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "maxLength": 80,
            "type": "string"
          },
          "label": { "minLength": 1, "maxLength": 120, "type": "string" },
          "weightBasisPoints": {
            "minimum": 1,
            "maximum": 10000,
            "type": "integer"
          },
          "missingInput": {
            "anyOf": [
              { "const": "block", "type": "string" },
              { "const": "zero", "type": "string" },
              { "const": "neutral", "type": "string" }
            ]
          },
          "criticalMinimumBasisPoints": {
            "anyOf": [
              { "minimum": 0, "maximum": 10000, "type": "integer" },
              { "type": "null" }
            ]
          }
        }
      }
    },
    "thresholds": {
      "maxProperties": 20,
      "type": "object",
      "patternProperties": {
        "^(.*)$": { "minimum": 0, "maximum": 10000, "type": "integer" }
      }
    },
    "displayScale": {
      "anyOf": [
        { "const": 5, "type": "number" },
        { "const": 100, "type": "number" }
      ]
    }
  }
}
