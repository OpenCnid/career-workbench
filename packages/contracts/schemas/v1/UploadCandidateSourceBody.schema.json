{
  "$id": "UploadCandidateSourceBody",
  "additionalProperties": false,
  "type": "object",
  "required": ["mediaType", "bytesBase64", "extractedText"],
  "properties": {
    "mediaType": {
      "anyOf": [
        { "const": "application/pdf", "type": "string" },
        { "const": "text/plain", "type": "string" }
      ]
    },
    "bytesBase64": {
      "minLength": 4,
      "maxLength": 6990508,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$",
      "type": "string"
    },
    "extractedText": { "minLength": 1, "maxLength": 49152, "type": "string" }
  }
}
