{
  "name": "@career-workbench/dsh-plugin",
  "version": "0.1.0-preview.0",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./service": {
      "types": "./lib/service.d.ts",
      "import": "./lib/service.js"
    },
    "./http-provider": {
      "types": "./lib/http-provider.d.ts",
      "import": "./lib/http-provider.js"
    }
  },
  "files": [
    "lib",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@career-workbench/contracts": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
