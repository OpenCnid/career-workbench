+/**
+ * Durable, parent-owned deletion tombstones for continuable subagents.
+ *
+ * Deletion deliberately does not remove session media. The direct parent's
+ * append-only log records that the address is revoked; retained child logs can
+ * still satisfy audit and retention policy without remaining resumable.
+ *
+ * @module @deepseek-ai/dsh-subagent/deletion
+ */
+import { SubagentError } from "./error.js";
+/** Fold the first durable deletion record for one child. */
+export function foldSubagentDeletion(events, childId) {
+    const event = events.find(candidate => candidate.type === 'subagent/deleted'
+        && typeof candidate.data === 'object'
+        && candidate.data !== null
+        && candidate.data.childId === childId);
+    if (event === undefined)
+        return undefined;
+    const data = event.data;
+    if (data.version !== 1 || typeof data.label !== 'string' || typeof data.deletedAt !== 'number') {
+        throw new SubagentError(`persisted deletion tombstone for subagent "${childId}" is invalid`, 'CORRUPT_DELETION');
+    }
+    return data;
+}
+/** Read every deleted direct-child id from one parent's current log. */
+function deletedChildIds(events) {
+    const ids = new Set();
+    for (const event of events) {
+        if (event.type !== 'subagent/deleted' || typeof event.data !== 'object' || event.data === null)
+            continue;
+        const data = event.data;
+        if (data.version === 1 && typeof data.childId === 'string')
+            ids.add(data.childId);
+    }
+    return ids;
+}
+/** Load a parent's live-preferred event log without resuming an Agent. */
+async function parentEvents(ctx, parentId, signal) {
+    signal?.throwIfAborted();
+    const sessions = ctx.get('sessions');
+    if (sessions === undefined) {
+        throw new SubagentError('listing deletion state requires the sessions service', 'LIST_FAILED');
+    }
+    const live = sessions.get(parentId);
+    if (live !== undefined)
+        return live.events;
+    const persistence = ctx.get('sessionPersistence');
+    if (persistence === undefined)
+        return [];
+    try {
+        const inspected = await persistence.inspect(parentId, signal);
+        signal?.throwIfAborted();
+        return inspected.events;
+    }
+    catch (error) {
+        signal?.throwIfAborted();
+        throw new SubagentError(`cannot inspect deletion state for parent session "${parentId}"`, 'LIST_FAILED', { cause: error });
+    }
+}
+/** Remove tombstoned direct children from a public child listing. */
+export async function filterDeletedChildren(ctx, parentId, rows, signal) {
+    if (rows.length === 0)
+        return rows;
+    const deleted = deletedChildIds(await parentEvents(ctx, parentId, signal));
+    return rows.filter(row => !deleted.has(row.id));
+}
+/** Remove tombstoned branches from a stable pre-order descendant listing. */
+export async function filterDeletedDescendants(ctx, rows, signal) {
+    if (rows.length === 0)
+        return rows;
+    const parentIds = [...new Set(rows.map(row => row.parentId))];
+    const deletions = new Map();
+    await Promise.all(parentIds.map(async (parentId) => {
+        deletions.set(parentId, deletedChildIds(await parentEvents(ctx, parentId, signal)));
+    }));
+    const blocked = new Set();
+    return rows.filter((row) => {
+        const hidden = blocked.has(row.parentId) || deletions.get(row.parentId)?.has(row.id) === true;
+        if (hidden)
+            blocked.add(row.id);
+        return !hidden;
+    });
+}
